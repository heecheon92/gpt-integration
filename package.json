{
  "name": "gpt-integration",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm lint && next dev --inspect",
    "dev:secure": "pnpm lint && next dev --inspect --experimental-https",
    "profile": "ANALYZE=true pnpm build",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm typecheck && biome lint",
    "lint:fix": "pnpm typecheck && biome lint --fix",
    "pret": "biome format",
    "pret:fix": "biome format --write",
    "biome": "pnpm typecheck && biome check . --max-diagnostics=100",
    "biome:fix": "pnpm typecheck && biome check . --write --max-diagnostics=100",
    "biome:summary": "biome check --reporter=summary --max-diagnostics=100",
    "prepare": "husky",
    "postinstall": "pnpm exec prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.94",
    "@ai-sdk/react": "4.0.145",
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.9.15",
    "@clerk/themes": "^2.4.64",
    "@hookform/resolvers": "^5.9.1",
    "@pinecone-database/pinecone": "^9.0.0",
    "@tabler/icons-react": "^3.49.0",
    "ai": "^7.0.141",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.21.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.11.2"
}
